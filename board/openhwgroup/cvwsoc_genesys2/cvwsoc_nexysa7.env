kernel_addr=0x80400000\0"
kernel_comp_addr_r=0x82000000\0"
fdt_addr=0x87000000\0"
gptbuf_off=0x200000\0"
gptcalc=
		setexpr gpt_addr ${kernel_comp_addr_r} + ${gptbuf_off};
		mmc read ${gpt_addr} 2 4;
		/* entry #1 */
		setexpr p1 ${gpt_addr};
		setexpr t ${p1} + 0x20; setexpr fdt_start *${t};
		setexpr t ${p1} + 0x28; setexpr fdt_end   *${t};
		setexpr fdt_size ${fdt_end} - ${fdt_start};
		setexpr fdt_size ${fdt_size} + 1;
		/* entry #4 (+0x180) */
		setexpr p4 ${gpt_addr} + 0x180;
		setexpr t ${p4} + 0x20; setexpr k_start *${t};
		setexpr t ${p4} + 0x28; setexpr k_end   *${t};
		setexpr k_size ${k_end} - ${k_start};
		setexpr k_size ${k_size} + 1;
bootcmd=run gptcalc; mmc read ${fdt_addr} ${fdt_start} ${fdt_size}; mmc read ${kernel_addr} ${k_start} ${k_size};
		setexpr kernel_comp_size ${k_size} * 0x200;
		booti ${kernel_addr} - ${fdt_addr};
